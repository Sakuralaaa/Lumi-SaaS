# =====================================================================
# Lumi 出图 — production environment.   cp .env.example .env  then fill in.
# Never commit .env. Values are read by server/src/config.ts (validated on boot;
# the API refuses to start in production with placeholder / weak secrets).
# =====================================================================

# ---- Domain / proxy -------------------------------------------------
# Domain Caddy serves and gets the HTTPS certificate for (DNS A record -> this server).
DOMAIN=app.example.com
# Public origin of the web app, must be https:// in production (used for CSRF origin checks).
PUBLIC_ORIGIN=https://app.example.com
# How many reverse-proxy hops to trust for the client IP (rate limits, audit log).
#   1      = behind exactly one Caddy (this compose stack)  <- use this
#   false  = API exposed directly (every client then shares one rate-limit bucket behind a proxy)
#   CIDRs  = e.g. 172.16.0.0/12,10.0.0.0/8
# Never `true` behind Caddy: it trusts the whole X-Forwarded-For chain, so if the proxy config ever
# appends instead of overwrites, clients can spoof their IP and dodge rate limits / fake audit IPs.
TRUST_PROXY=1
# Must stay true in production (the API refuses to start otherwise).
COOKIE_SECURE=true

# ---- Server ----------------------------------------------------------
NODE_ENV=production
PORT=8787
HOST=0.0.0.0

# ---- Database / Redis -------------------------------------------------
# docker compose builds DATABASE_URL from POSTGRES_PASSWORD (host `postgres`) and sets
# REDIS_URL=redis://redis:6379 itself. Use a URL-safe password:  openssl rand -hex 24
POSTGRES_PASSWORD=
# Only needed outside compose (Zeabur / managed DB). Keep in sync with POSTGRES_PASSWORD.
# DATABASE_URL=postgres://lumi:<password>@postgres:5432/lumi
# REDIS_URL=redis://redis:6379

# ---- Secrets -----------------------------------------------------------
# Signs local file URLs / sessions. >= 32 chars:   openssl rand -base64 48
APP_SECRET=
# Encrypts stored upstream API keys (AES-256-GCM). Must decode to EXACTLY 32 bytes:
#   openssl rand -base64 32
# !!! Back it up OFFLINE (password manager + paper). Losing it = every saved upstream key is unreadable.
MASTER_KEY=
MASTER_KEY_VERSION=1
# Old keys kept during rotation, "version:base64" comma-separated, e.g. 1:AAAA...,2:BBBB...
MASTER_KEYS_OLD=

# ---- First admin (first boot only) --------------------------------------
# Creates the admin account if missing (password >= 12 chars). Uncomment for the first boot.
# After the first login DELETE (or re-comment) the ADMIN_PASSWORD line and run `docker compose up -d`.
# Do not leave them as empty `ADMIN_EMAIL=` / `ADMIN_PASSWORD=`: empty values fail validation.
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=

# ---- Storage --------------------------------------------------------------
# local = files in the `appdata` docker volume (/app/data/storage). OK to start with.
# s3    = recommended for production: a PRIVATE S3 / Cloudflare R2 bucket (no public access;
#         the app hands out short-lived signed URLs).
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=/app/data/storage
S3_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=lumi
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# true for R2 / MinIO; false for AWS S3 virtual-hosted style if you prefer.
S3_FORCE_PATH_STYLE=true

# ---- Retention / alerts -----------------------------------------------------
# Days user uploads and generated images are kept before the cron service deletes them (1–3650).
RETENTION_DAYS=30
# Ops alerts (upstream failure rate, circuit breaker open, cron failures). Auto-detects
# 飞书/Lark, 企业微信, 钉钉, Discord, Slack webhooks; anything else gets generic JSON. Empty = log only.
ALERT_WEBHOOK_URL=

# ---- Upstream (dev only — keep false in production) ------------------------
UPSTREAM_USE_ENV_PROXY=false
UPSTREAM_ALLOW_PRIVATE=false

# Served by the api container itself (set in the Dockerfile). Leave unset.
# WEB_DIST_DIR=/app/web/dist

# ---- deploy/backup.sh (optional; read from this file by the script) ---------
# age public key for encrypting dumps (age-keygen -o key.txt; keep key.txt OFF the server)
AGE_RECIPIENT=
# rclone remote:path for off-site copies, e.g. r2:lumi-backups/db
RCLONE_REMOTE=
BACKUP_DIR=/var/backups/lumi
BACKUP_KEEP=14
